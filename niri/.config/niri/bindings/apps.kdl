binds {
// hotkey overlay
Mod+Shift+Slash { show-hotkey-overlay; }

// default applications
Mod+E hotkey-overlay-title="File Manager" { spawn "thunar"; }
Mod+Shift+E hotkey-overlay-title="File Manager (floating)" { spawn "thunar" "--name=dfr.floating.thunar"; }
Mod+T hotkey-overlay-title="File Manager" { spawn "zed"; }
Mod+B hotkey-overlay-title="Browser" { spawn "brave-origin"; }
Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }

//Mod+P { spawn "hyprpicker" "-a"; }
}
