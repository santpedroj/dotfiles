binds {
// hotkey overlay
Mod+Shift+Slash { show-hotkey-overlay; }

// default applications
Mod+E hotkey-overlay-title="File Manager" { spawn "nautilus"; }
Mod+Shift+E hotkey-overlay-title="File Manager (floating)" { spawn "nautilus" "--name=dfr.floating.thunar"; }
Mod+T hotkey-overlay-title="File Manager" { spawn "zed"; }
Mod+B hotkey-overlay-title="Browser" { spawn "brave-origin"; }
Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }

//Mod+P { spawn "hyprpicker" "-a"; }

// Layout switcher
    Mod+S hotkey-overlay-title="Switch Layout" { switch-layout "next"; }

    // Window switcher
    Alt+Tab hotkey-overlay-title="Window Switcher" { spawn "noctalia" "msg" "window-switcher"; }

    // Panels and settings
    Mod+A repeat=false  hotkey-overlay-title="Open Notifications" { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Z repeat=false hotkey-overlay-title="Open Noctalia Settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+X repeat=false hotkey-overlay-title="Open Control Center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Space repeat=false  hotkey-overlay-title="Open Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Shift+W repeat=false  hotkey-overlay-title="Open Wallpaper Selector" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+V repeat=false  hotkey-overlay-title="Open Clipboard" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    // Screenshot
    Ctrl+Shift+S hotkey-overlay-title="Noctalia Screenshot" { spawn "noctalia" "msg" "screenshot-region"; }

    // Night light
    Mod+N hotkey-overlay-title="Enable Night Light" { spawn "noctalia" "msg" "nightlight-enable"; }
    Mod+Alt+N hotkey-overlay-title="Disable Night Light" { spawn "noctalia" "msg" "nightlight-disable"; }

    // Session
    Mod+Alt+C hotkey-overlay-title="Open Session Manager" { spawn "noctalia" "msg" "panel-toggle" "session"; }

    // Sound
    XF86AudioRaiseVolume { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute { spawn "noctalia" "msg" "volume-mute"; }

    // Brightness
    XF86MonBrightnessUp { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown { spawn "noctalia" "msg" "brightness-down"; }

    // General
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    // Focus
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // Move windows
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    // Resize
    Mod+R       hotkey-overlay-title="Cycle preset widths" { switch-preset-column-width; }

    Mod+Ctrl+H hotkey-overlay-title="Decrease column width" { set-column-width "-10%"; }
    Mod+Ctrl+L hotkey-overlay-title="Increase column width" { set-column-width "+10%"; }
    Mod+Ctrl+J hotkey-overlay-title="Decrease window height" { set-window-height "-10%"; }
    Mod+Ctrl+K hotkey-overlay-title="Increase window height" { set-window-height "+10%"; }

    // Monitor navigation
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    // Move to monitor
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }

    // Workspace navigation
    Ctrl+Alt+L { focus-workspace-down; }
    Ctrl+Alt+H { focus-workspace-up; }

    Mod+Ctrl+D { move-column-to-workspace-down; }
    Mod+Ctrl+U { move-column-to-workspace-up; }

    Mod+Shift+D hotkey-overlay-title="Move workspace down" { move-workspace-down; }
    Mod+Shift+U hotkey-overlay-title="Move workspace up" { move-workspace-up; }

    // Mouse wheel
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Hyprland muscle memory
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Column management
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma repeat=false { consume-window-into-column; }
    Mod+Period repeat=false { expel-window-from-column; }

    // Layout
    Mod+Shift+R hotkey-overlay-title="Cycle preset heights" { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+M repeat=false { maximize-column; }
    Mod+F repeat=false { fullscreen-window; }
    Mod+Shift+F repeat=false { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // Floating
    Mod+Shift+T { toggle-window-floating; }

    // Overview
    Mod+W { toggle-column-tabbed-display; }

    // Session
    //Mod+Shift+E { quit; }
    //Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }
}
